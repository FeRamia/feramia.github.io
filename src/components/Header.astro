---
import Icon from './Icon.astro';
import { profile, type Lang } from '../data/profile';
import { useTranslations, localePath } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const links = [
  ['#about', t('nav.about')],
  ['#expertise', t('nav.expertise')],
  ['#experience', t('nav.experience')],
  ['#skills', t('nav.skills')],
  ['#projects', t('nav.projects')],
  ['#contact', t('nav.contact')],
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={localePath(lang)} class="font-mono text-sm font-medium tracking-tight">
      <span class="text-accent">&lt;</span>{profile.shortName}<span class="text-accent"> /&gt;</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm text-muted md:flex">
      {links.map(([href, label]) => <li><a href={href} class="transition hover:text-fg">{label}</a></li>)}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={localePath(other)}
        hreflang={other}
        class="rounded-md border border-line px-2.5 py-1 font-mono text-xs uppercase hover:border-accent hover:text-accent"
        data-track="language_switch"
        data-track-label={other}
      >
        {other}
      </a>
      <button id="theme-toggle" type="button" aria-label={t('theme.toggle')} class="rounded-md p-2 text-muted hover:text-fg">
        <Icon name="sun" class="h-5 w-5 theme-sun" />
        <Icon name="moon" class="h-5 w-5 theme-moon" />
      </button>
      <button id="menu-toggle" type="button" aria-label={t('menu.toggle')} aria-expanded="false" class="rounded-md p-2 text-muted hover:text-fg md:hidden">
        <Icon name="menu" />
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" hidden class="border-t border-line bg-bg px-4 py-3 text-sm md:hidden">
    {links.map(([href, label]) => <li><a href={href} class="block py-2 text-muted hover:text-fg">{label}</a></li>)}
  </ul>
</header>

<style is:global>
  /* Global: las clases están en el <svg> del componente Icon, fuera del scope de este componente */
  .theme-moon { display: none; }
  :root[data-theme='dark'] .theme-sun { display: none; }
  :root[data-theme='dark'] .theme-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-sun { display: none; }
    :root:not([data-theme='light']) .theme-moon { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    if (!menu) return;
    menu.hidden = !menu.hidden;
    menuBtn.setAttribute('aria-expanded', String(!menu.hidden));
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.hidden = true; }));
</script>
