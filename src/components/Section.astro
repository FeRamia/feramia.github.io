---
interface Props { id: string; eyebrow: string; title: string; subtitle?: string; soft?: boolean }
const { id, eyebrow, title, subtitle, soft = false } = Astro.props;
---

<section id={id} class:list={['py-20 sm:py-24', soft && 'bg-bg-soft']}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal mb-12 max-w-2xl">
      <p class="section-eyebrow">{eyebrow}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 text-muted">{subtitle}</p>}
    </div>
    <slot />
  </div>
</section>
